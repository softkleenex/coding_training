#!/bin/bash
# 커밋 직전에 포스트를 자동 생성하고 커밋에 포함시킵니다.
# GitHub Actions와 로컬 저장소 간의 충돌을 방지합니다.

echo "============================================="
echo " 📝 [pre-commit hook] 포스트(마크다운) 자동 생성 중..."
echo "============================================="

python3 scripts/format_problems.py
python3 scripts/update_readme.py

# 생성/수정된 파일들을 자동으로 git add (커밋에 포함)
git add content/ README.md

echo "✨ 포스트 생성 및 추가 완료! 커밋을 계속 진행합니다."
